{
  "pipeline": "AI Video Pipeline — 2分钟长视频全免费端到端工作流",
  "version": "1.0",
  "owner": "Peter",
  "language": "zh-CN",
  "target": {
    "duration_sec": 120,
    "duration_range_sec": [
      100,
      150
    ],
    "resolution": "1080x1920",
    "aspect": "9:16",
    "fps": 30,
    "codec": "H.264",
    "cost": "100% free: 开源工具 + 本地算力 + 每日免费额度，禁止付费API"
  },
  "nodes": [
    {
      "id": "node1_script",
      "name": "Node 1：2分钟剧本与情绪节拍拆解",
      "type": "Script Engine",
      "inputs": [
        "theme",
        "persona",
        "audience"
      ],
      "outputs": [
        "script.md",
        "script.json"
      ],
      "spec": {
        "length_chars": "400-500",
        "pace_chars_per_min": 240,
        "beats": [
          {
            "range": "00:00-00:05",
            "name": "黄金前3秒反常识钩子"
          },
          {
            "range": "00:05-00:30",
            "name": "痛点场景共鸣与误区揭露"
          },
          {
            "range": "00:30-01:15",
            "name": "核心认知提升/干货解法展开"
          },
          {
            "range": "01:15-01:45",
            "name": "行动号召与金句总结"
          },
          {
            "name": "互动结语与引导关注",
            "range": "01:45-02:00"
          }
        ]
      },
      "next": [
        "node2_storyboard"
      ]
    },
    {
      "id": "node2_storyboard",
      "name": "Node 2：结构化分镜与运镜拆解",
      "type": "Storyboard Engine",
      "inputs": [
        "script.json"
      ],
      "outputs": [
        "storyboard.json"
      ],
      "spec": {
        "shots": "16-20",
        "duration_sec_each": "4-6",
        "fields": [
          "shot_id",
          "duration",
          "scene_type",
          "camera_motion",
          "visual_prompt",
          "voiceover_text"
        ]
      },
      "next": [
        "node3_anchor",
        "node4_tts"
      ]
    },
    {
      "id": "node3_anchor",
      "name": "视觉锚点（Muse 自带替换版）",
      "type": "Visual Anchor & Keyframes",
      "inputs": [
        "storyboard.json",
        "reference_image"
      ],
      "outputs": [
        "assets/keyframes/shot_01.png"
      ],
      "spec": {
        "rule": "先锁定人物/产品参考图，后续统一走图生视频 I2V 或带参考生视频 R2V",
        "prompt_template": "画质词 + 服装 + 发型 + 材质 + 光影，固定不变",
        "free_tools": [
          "Liblib（免费额度）",
          "Bing DALL-E 3",
          "即梦（免费额度）"
        ],
        "note": "免费额度会变，用前先核对官网；关键帧只做参考，不当实拍"
      },
      "next": [
        "node5_prompt"
      ],
      "description": "原方案 Liblib / Bing DALL·E 3 / 即梦手动生关键帧，已替换为 Muse 自带：anchor_muse.py 生成统一锚点提示词（Peter 照片、灰色卫衣、宿舍书桌、写实 B-roll、无字幕虚化屏幕），Muse 逐镜生成竖屏视频，放到 assets/videos/shot_XX.mp4。",
      "script": "scripts/anchor_muse.py"
    },
    {
      "id": "node4_tts",
      "name": "配音（Muse 自带替换版，edge-tts 备选）",
      "type": "Free Audio Engine",
      "inputs": [
        "storyboard.json"
      ],
      "outputs": [
        "assets/audios/shot_01.mp3"
      ],
      "spec": {
        "engine": "edge-tts（开源，0成本）",
        "voices": [
          "zh-CN-YunxiNeural",
          "zh-CN-XiaoxiaoNeural"
        ],
        "rule": "先生成配音，再按音频实际毫秒时长反向校准视频时间线"
      },
      "next": [
        "node6_stitch"
      ],
      "description": "原方案 edge-tts（zh-CN-YunxiNeural）在虚拟机里连不上 speech.platform.bing.com（SSL 报错）。已替换为 tts_muse.py（Muse 自带配音，已实测 20 段、总 96.6 秒），接口与 tts_edge.py 一致，同样输出 shot_XX.mp3 和 durations.json；要 Yunxi 音色在自己电脑上跑 tts_edge.py；Peter 自己配音优先，录好后用 tts_muse.py --probe-only 生成 durations.json。",
      "script": "scripts/tts_muse.py（替换），scripts/tts_edge.py（备选）"
    },
    {
      "id": "node5_prompt",
      "name": "Node 5：模型提示词编译器",
      "type": "Prompt Adapter",
      "inputs": [
        "storyboard.json",
        "assets/keyframes/shot_01.png"
      ],
      "outputs": [
        "prompts/kling.json",
        "prompts/seedream.json",
        "prompts/minimax.json"
      ],
      "spec": {
        "targets": [
          "快手可灵 Kling",
          "豆包即梦 SeaDream",
          "MiniMax 海螺"
        ],
        "fields": [
          "主体",
          "光影质感",
          "运动幅度",
          "负面过滤词"
        ],
        "note": "各家免费额度不同，编译只做提示词适配，不保证额度"
      },
      "next": [
        "node6_stitch"
      ]
    },
    {
      "id": "node6_stitch",
      "name": "Node 6：本地 FFmpeg 自动化对齐与混音拼接",
      "type": "Auto-Stitch Engine",
      "inputs": [
        "assets/videos/*.mp4",
        "assets/audios/*.mp3",
        "assets/bgm/bgm.mp3"
      ],
      "outputs": [
        "output/final_video_2min.mp4"
      ],
      "spec": {
        "video": "1080x1920, 9:16, 30fps, H.264",
        "voice_loudness": "-14 LUFS / -14dB，归一化",
        "bgm": "-22dB，闪避 Ducking",
        "rule": "按分镜顺序拼接，音频时长为准，视频片段按需截取/补帧"
      },
      "next": [
        "node7_jianying"
      ]
    },
    {
      "id": "node7_jianying",
      "name": "Node 7：剪映工程草稿导出与字幕包装",
      "type": "Jianying Draft Exporter",
      "inputs": [
        "output/final_video_2min.mp4",
        "storyboard.json"
      ],
      "outputs": [
        "draft_content.json"
      ],
      "spec": {
        "note": "生成剪映电脑版工程草稿，打开即可用智能字幕/花字识别，无需手动打字对轴；草稿格式以剪映当前版本为准，导入前先备份"
      },
      "next": []
    }
  ],
  "edges": [
    [
      "node1_script",
      "node2_storyboard"
    ],
    [
      "node2_storyboard",
      "node3_anchor"
    ],
    [
      "node2_storyboard",
      "node4_tts"
    ],
    [
      "node3_anchor",
      "node5_prompt"
    ],
    [
      "node4_tts",
      "node6_stitch"
    ],
    [
      "node5_prompt",
      "node6_stitch"
    ],
    [
      "node6_stitch",
      "node7_jianying"
    ]
  ],
  "github_note": "GitHub仓库 fanpeter853-glitch/ai-video-pipeline（Public，main），已推送。主示例是 Peter 真实版 example_2min/（先做最小的一步，462字、20镜）；通用备选示例保留在仓库 example_2min/sample_script_2min.md 和 sample_storyboard.json（18镜）。分镜台词同时写 voiceover_text 和 voiceover 两个字段，内容一致。"
}